# ==========================================
# BrewLite - Environment Variables Template
# ==========================================
# Mẫu tham khảo: đặt các biến backend vào backend/.env, frontend vào frontend/.env.local

# ---- Database ----
# Khi chạy PostgreSQL qua Docker (docker/docker-compose.dev.yml), port mặc định là 5433
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5433/brewlite
# Nếu dùng PostgreSQL cài trực tiếp trên máy ở port 5432:
# DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite

# ---- Backend (NestJS) ----
PORT=3001
BACKEND_PORT=3001
JWT_SECRET=brewlite-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---- Docker (PostgreSQL) ----
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_PORT=5433

# ---- Cổng thanh toán SePay (VietQR Test Mode) ----
SEPAY_API_KEY=replace-with-your-local-sepay-key
SEPAY_BANK_NAME=Vietcombank
SEPAY_ACCOUNT_NO=0000000001
SEPAY_ACCOUNT_NAME="Che Van Nam"
