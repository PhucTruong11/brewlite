    {
      "name": "2. Cart Validate CSV",
      "item": [
        {
          "name": "POST /api/cart/validate (tu cart_validate_data.csv)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.iterationData.get('productId')) {",
                  "  pm.variables.set('productId', '1c0d8c51-38c3-43c7-a799-9402b6e7f0ad');",
                  "  pm.variables.set('size', 'S');",
                  "  pm.variables.set('qty', 1);",
                  "  pm.variables.set('lineTotal', 29000);",
                  "}",
                  "const tname = pm.iterationData.get('toppingName');",
                  "pm.variables.set('toppingsJson', tname ? JSON.stringify([tname]) : '[]');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const rawExp = pm.iterationData.get('expectedAvailable');",
                  "const expectedAvailable = rawExp !== undefined ? String(rawExp) === 'true' : true;",
                  "const j = pm.response.json();",
                  "const actualAvailable = j.available !== undefined ? j.available : j.data.available;",
                  "pm.test('Ket qua kiem tra ton kho khop expectedAvailable', () => pm.expect(actualAvailable).to.equal(expectedAvailable));",
                  "pm.test('Thoi gian phan hoi < 3000ms (NFR-01)', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"size\": \"{{size}}\",\n      \"qty\": {{qty}},\n      \"toppings\": {{toppingsJson}},\n      \"lineTotal\": {{lineTotal}}\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/cart/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cart",
                "validate"
              ]
            }
          },
          "response": []
        }
      ]
    },
